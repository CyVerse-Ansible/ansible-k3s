cdi:
  enabled: {{ K3S_NVIDIA_CDI_ENABLE | lower }}
driver:
  enabled: {{ K3S_NVIDIA_GPU_OPERATOR_DRIVER | lower }}
toolkit:
  enabled: {{ K3S_NVIDIA_GPU_OPERATOR_TOOLKIT | lower }}
  env:
    - name: CONTAINERD_SOCKET
      value: /run/k3s/containerd/containerd.sock
{% if K3S_NVIDIA_GPU_OPERATOR_TOOLKIT|bool %}
    - name: CONTAINERD_CONFIG
      value: /var/lib/rancher/k3s/agent/etc/containerd/config.toml
{% endif %}
mig:
  strategy: none
devicePlugin:
  config:
    create: true
    name: device-plugin-config
    default: any
    data:
      any: |-
        version: v1
        flags:
          migStrategy: none
{% if K3S_GPU_TIMESLICE_ENABLE|bool %}
        sharing:
          timeSlicing:
            resources:
              - name: nvidia.com/gpu
                replicas: {{ K3S_GPU_TIMESLICE_NUM }}
{% endif %}
operator:
  runtimeClass: nvidia
{% if K3S_WORKER_TOLERATIONS|length > 0 %}
  tolerations:
{% for toleration in K3S_WORKER_TOLERATIONS %}
  - key: "{{ toleration.key }}"
    operator: "{{ toleration.operator }}"
    value: "{{ toleration.value }}"
    effect: "{{ toleration.effect }}"
{% endfor %}
daemonsets:
  tolerations:
{% for toleration in K3S_WORKER_TOLERATIONS %}
  - key: "{{ toleration.key }}"
    operator: "{{ toleration.operator }}"
    value: "{{ toleration.value }}"
    effect: "{{ toleration.effect }}"
{% endfor %}
{% endif %}

{% if K3S_WORKER_TOLERATIONS|length > 0 or K3S_LEADER_TOLERATIONS|length > 0 %}
node-feature-discovery:
{% if K3S_WORKER_TOLERATIONS|length > 0 %}
  worker:
    tolerations:
{% for toleration in K3S_WORKER_TOLERATIONS %}
    - key: "{{ toleration.key }}"
      operator: "{{ toleration.operator }}"
      value: "{{ toleration.value }}"
      effect: "{{ toleration.effect }}"
{% endfor %}
{% endif %}
{% if K3S_LEADER_TOLERATIONS|length > 0 %}
  gc:
    tolerations:
{% for toleration in K3S_LEADER_TOLERATIONS %}
    - key: "{{ toleration.key }}"
      operator: "{{ toleration.operator }}"
      value: "{{ toleration.value }}"
      effect: "{{ toleration.effect }}"
{% endfor %}
  master:
    tolerations:
{% for toleration in K3S_LEADER_TOLERATIONS %}
    - key: "{{ toleration.key }}"
      operator: "{{ toleration.operator }}"
      value: "{{ toleration.value }}"
      effect: "{{ toleration.effect }}"
{% endfor %}
{% endif %}
{% endif %}
